{
  "name": "github-manager",
  "version": "0.1.7",
  "description": "Multi-account GitHub manager desktop app: repos, Actions, Releases & built-in MCP server",
  "author": {
    "name": "integemjack",
    "email": "integemjack@users.noreply.github.com"
  },
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/integemjack/github-manager.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack": "electron-vite build && electron-builder --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:all": "electron-vite build && electron-builder -mwl"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.integemjack.github-manager",
    "productName": "GitHub Manager",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**",
      "extras/**"
    ],
    "artifactName": "GitHub-Manager-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "artifactName": "GitHub-Manager-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
